{
  "name": "protocol-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "data": "node ../tools/export_atlas.mjs",
    "data:check": "node ../tools/export_atlas.mjs --check",
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "npm run data:check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5179 --strictPort",
    "test": "node --test ../test/test_atlas_data.mjs ../test/test_atlas_model.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
