size":5946,"digest":"sha256:faa3e410da54bc90439269a979d8109a13904cf2acb27de2795469850265f62f","download_count":0,"created_at":"2026-11-13T09:24:20Z","updated_at":"2026-11-13T09:24:20Z","browser_download_url":"https://github.com/KG-khangelani/protocol-emulator-asic/releases/download/v0.1.0-alpha.7/spi-timed-refinement_p.json"},{"url":"https://api.github.com/repos/KG-khangelani/protocol-emulator-asic/releases/assets/743048583","id":743048583,"node_id":"RA_kwDOUmYlXs4sSgWH","name":"toolchain.lock.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":7328,"digest":"sha256:e2c31a35607ce0c86503e4252d4eb5342c8f00c8ff5f059dfde62dd7fbd52153","download_count":0,"created_at":"2026-11-13T09:24:20Z","updated_at":"2026-11-13T09:24:20Z","browser_download_url":"https://github.com/KG-khangelani/protocol-emulator-asic/releases/download/v0.1.0-alpha.7/toolchain.lock.json"}],"tarball_url":"https://api.github.com/repos/KG-khangelani/protocol-emulator-asic/tarball/v0.1.0-alpha.7","zipball_url":"https://api.github.com/repos/KG-khangelani/protocol-emulator-asic/zipball/v0.1.0-alpha.7","body":"# G3: readable programs for the qualified shared protocol core\n\nThis milestone adds a small versioned assembler, timing listings and public\nload/readback/run plans for G2's unchanged SRAM core (interface 0x22).\nIt adds thirteen readable examples: UART transmit and bounded receive, both\nbit orders of all four SPI modes, and I2C write/read/repeated-START transactions.\nTheir machine words exactly match the independently encoded G2 programs.\n\nClean committed-source CI and a separate clean local clone pass twenty assembler\nacceptance tests and four public-interface groups / 55 cases per simulator.\nAll normalized observations agree between Icarus and Verilator, including 15\nexpected rejections. Windows, Linux CI and the clean clone produce the same 53\nprogram files byte for byte. The local full repository check passes 147 tests.\nE0046 retains original archives, logs, source bindings and a portable audit.\n\nThe G3 download includes the standalone Python assembler, readable sources,\ncompiled binaries, JSON images, timing listings and loading plans. The two\noriginal CI archives and G3 manifest/checksum list are separate assets. The\nrelease source preserves all 351 verified toolchain inputs from implementation\ncommit 0297655; the milestone publication adds its own checked workbench image.\n\nBuild and verify from a checkout:\n\n```powershell\n.\\tools\\workbench.ps1 Programs\n.\\tools\\workbench.ps1 ProgramTest\n```\n\nLinux uses `./tools/workbench.sh Programs` and `ProgramTest`. Outputs go to a new\ndirectory under `build/programs/`. See `docs/programming.md` for writing a source,\nreading its schedule and following the public pin-level plan. Invalid programs,\nbad target versions, capacity errors and readback mismatches fail before run.\n\nThe twenty qualified physical inputs are unchanged. Alpha.6 retains G2's actual\nrouted/timing/precheck/netlist evidence and original downloads; this software\nmilestone does not rerun or replace physical qualification. Its production\nprofile still identifies that original alpha.6 hardware adoption.\n\nUART receive remains bounded with explicit framing, delivery and host-service\nlimits. SPI requires the declared input-hold profile. I2C validation is digital,\nwith stated open-drain, pull-up, stretch and cleanup assumptions. No new analog,\nsilicon, maximum-frequency, minimum-ISA, owner-fluency or final-submission result\nis claimed. G4 submission readiness remains separately queued.\n\nVerified workbench: `ghcr.io/kg-khangelani/protocol-emulator-asic-workbench@sha256:f487aaf03906535a3187690557ff97ca1707e966b48ae8a99362683b5f68e307`\n\nPublication checks: https://github.com/KG-khangelani/protocol-emulator-asic/actions/runs/43397350476\n"}